# Скопируйте в .env и правьте под свой хакатон. .env в git не попадает.

# --- Бренд: три строки, которые отличают ваше решение от заготовки ---
APP_TITLE=Паспорт ухода
APP_SUBTITLE=exit-интервью → паспорт проблемы → дашборд
APP_PORT=80

# --- Обязательно поменять перед любым показом наружу ---
APP_SECRET_KEY=смените-на-случайную-строку
APP_DEMO_PASSWORD=demo2026

# --- Языковая модель ---
# Ollama в контуре: http://ollama:11434 (модель тянется командой ollama pull).
# Облачный OpenAI-совместимый сервис: базовый URL вида https://.../v1 плюс ключ.
# Провайдер определяется по URL автоматически, APP_LLM_PROVIDER — только чтобы
# переопределить вручную (ollama|openai).
APP_LLM_BASE_URL=http://ollama:11434
APP_LLM_MODEL=qwen2.5:7b-instruct
APP_LLM_API_KEY=
APP_LLM_TIMEOUT=180

# --- Метрика «было / стало» ---
# Сколько минут та же работа занимает у специалиста вручную. Цифру спросите
# у заказчика прямо — на ней строится главный слайд защиты.
APP_BASELINE_MANUAL_MINUTES=40

# --- Единый вход через Keycloak (по умолчанию выключен) ---
# Включается вместе с docker-compose.keycloak.yml. Оставляйте локальный вход
# запасным путём, пока не уверены в стенде.
APP_OIDC_ENABLED=false
APP_LOCAL_LOGIN_ENABLED=true
APP_OIDC_ISSUER=http://localhost:8080/realms/hackathon
APP_OIDC_CLIENT_ID=app
APP_OIDC_CLIENT_SECRET=
APP_OIDC_REDIRECT_URL=http://localhost/api/auth/oidc/callback
APP_OIDC_POST_LOGOUT_URL=http://localhost/login
APP_OIDC_ROLE_MAP=app-leader:leader,app-expert:expert,app-analyst:analyst
APP_OIDC_DEFAULT_ROLE=analyst

# Адреса, по которым браузер видит сервисы. На сервере меняйте на публичные:
# issuer в токене обязан совпасть с тем, что видит браузер, иначе вход отклоняется.
KEYCLOAK_PUBLIC_URL=http://localhost:8080
KEYCLOAK_PORT=8080
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
APP_PUBLIC_URL=http://localhost

# --- Хранилища (по умолчанию файловые, ничего поднимать не нужно) ---
APP_DATA_DIR=data
# APP_DATABASE_URL=postgresql+psycopg2://app:app@db:5432/app
# APP_QDRANT_URL=http://qdrant:6333
# APP_EMBED_MODEL=intfloat/multilingual-e5-small
