{
  "realm": "hackathon",
  "enabled": true,
  "displayName": "Хакатон",
  "loginTheme": "keycloak",
  "sslRequired": "none",
  "registrationAllowed": false,
  "roles": {
    "realm": [
      {
        "name": "app-leader",
        "description": "Руководитель: полный просмотр"
      },
      {
        "name": "app-expert",
        "description": "Профильный специалист"
      },
      {
        "name": "app-analyst",
        "description": "Аналитик: базовый доступ"
      }
    ]
  },
  "clients": [
    {
      "clientId": "app",
      "name": "Сервис хакатона",
      "enabled": true,
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "serviceAccountsEnabled": false,
      "attributes": {
        "pkce.code.challenge.method": "S256",
        "post.logout.redirect.uris": "http://localhost:8000/*##http://localhost:8010/*##http://localhost/*##http://127.0.0.1:8000/*##http://127.0.0.1:8010/*##http://13.143.181.167/*"
      },
      "redirectUris": [
        "http://127.0.0.1:8000/api/auth/oidc/callback",
        "http://127.0.0.1:8010/api/auth/oidc/callback",
        "http://13.143.181.167/api/auth/oidc/callback",
        "http://localhost/api/auth/oidc/callback",
        "http://localhost:8000/api/auth/oidc/callback",
        "http://localhost:8010/api/auth/oidc/callback"
      ],
      "webOrigins": [
        "+"
      ],
      "protocolMappers": [
        {
          "name": "realm roles",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-usermodel-realm-role-mapper",
          "config": {
            "claim.name": "realm_access.roles",
            "jsonType.label": "String",
            "multivalued": "true",
            "id.token.claim": "true",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ],
